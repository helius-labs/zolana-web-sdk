{
  "name": "@zolana/browser-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser benchmark for local Zolana proving with zopro.",
  "scripts": {
    "keys": "node ../../packages/web-prover/dist/scripts/install-keys.mjs --output public/keys --keys transfer_confidential_2_2.key",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "node scripts/test-browser.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@heliuslabs/zolana-web-prover": "^0.4.2-alpha",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
