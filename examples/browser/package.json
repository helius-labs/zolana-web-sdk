{
  "name": "@zolana/browser-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Focused browser demo for local Zolana proving with Go and threaded Arkworks engines.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "node scripts/test-mopro-browser.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@heliuslabs/zolana": "0.3.1-alpha",
    "@solana/kit": "^8.3.0",
    "@zolana/web-prover": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@solana-program/system": "^0.14.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
