{
  "name": "@zolana/web-prover",
  "version": "0.1.0",
  "description": "Local Zolana Groth16 proving for browsers.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "zolana-prover-assets": "./dist/scripts/setup-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "../../scripts/build-wasm.sh && vite build && tsc -p tsconfig.build.json && node ../../scripts/prepare-prover-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
