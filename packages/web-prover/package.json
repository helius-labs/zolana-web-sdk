{
  "name": "@heliuslabs/zolana-web-prover",
  "version": "0.2.0-alpha",
  "description": "Local Zolana Groth16 proving for browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zolana-web-sdk.git",
    "directory": "packages/web-prover"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "bin": {
    "zolana-prover-assets": "dist/scripts/setup-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "../../scripts/build-wasm.sh && vite build && tsc -p tsconfig.build.json && node ../../scripts/prepare-prover-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:keys": "node scripts/generate-key-digests.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
